
&i2c0 {
	status = "okay";
	focaltech@38 {
		compatible = "focaltech,fts";
		reg = <0x38>;
		interrupt-parent = <&pio>;
		interrupts = <0 IRQ_TYPE_EDGE_FALLING 0 0>;
		focaltech,reset-gpio = <&pio 174 0x00>;
		focaltech,irq-gpio = <&pio 0 0x00>;
		focaltech,display-coords = <0 0 719 1559>;
		focaltech,max-touch-number = <10>;
	};

	chipone_tddi@58 {
		compatible = "chipone-tddi";
		reg = <0x58>;
		interrupt-parent = <&pio>;
		interrupts = <0 IRQ_TYPE_EDGE_FALLING 0 0>;
		chipone,rst-gpio = <&pio 174 0x00>;
		chipone,irq-gpio = <&pio 0 0x00>;
		chipone,x-res = <719>;
		chipone,y-res = <1559>;
	};

	himax-ts@48 {
		compatible = "himax,hxcommon";
		reg = <0x48>;
		interrupt-parent = <&pio>;
		interrupts = <0 IRQ_TYPE_EDGE_FALLING 0 0>;
		himax,panel-coords = <0 719 0 1559>;
		himax,display-coords = <0 719 0 1559>;
		himax,irq-gpio = <&pio 0 0x00>;
		himax,rst-gpio = <&pio 174 0x00>;
		report_type = <1>;
	};
};
