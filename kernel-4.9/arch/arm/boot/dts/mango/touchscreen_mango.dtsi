
&i2c0 {
	status = "okay";
	synaptics_dsx@22 {
		compatible = "synaptics,dsx-i2c";
		reg = <0x22>;
		synaptics,pwr-reg-name = "vdd_ana";
		vdd_ana-supply = <&mt_pmic_vldo28_ldo_reg>;
		synaptics,irq-gpio = <&pio 0 0x2002>;
		synaptics,reset-gpio = <&pio 174 0x00>;
		synaptics,power-on-state = <1>;
		synaptics,irq-on-state = <0>;
		synaptics,reset-on-state = <0>;
		synaptics,power-delay-ms = <20>;
		synaptics,reset-delay-ms = <90>;
		synaptics,reset-active-ms = <20>;
	};
	goodix_ts@14 {
		compatible = "goodix,gt1x";
		reg = <0x14>;
		vdd_ana-supply = <&mt_pmic_vldo28_ldo_reg>;
		goodix,rst-gpio = <&pio 174 0>;
		goodix,irq-gpio = <&pio 0 0x2002>;
	};

};