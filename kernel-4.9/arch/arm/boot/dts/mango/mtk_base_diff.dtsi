/*
 * when you want to delete some nodes or property, modify this dtsi.
 * some diff between mtk and zte pluto.
 */

#include "../bat_setting/battery_protect_policy_080500100328.dtsi"

/{
	/*add for Z5157V flash chip node*/
	flashlights_aw3644: flashlights_aw3644 {
		compatible = "mediatek,flashlights_aw3644";
	};
	flashlights_dummy_gpio: flashlights_dummy_gpio {
		compatible = "mediatek,flashlights_dummy_gpio";
	};

	zte_misc: zte_misc {
		status="okay";
		compatible = "zte-misc";
	};

	/*fingerprint nav*/
	zte_fp_nav: zte_fp_nav {
		status="okay";
		compatible = "zte_fp_nav";
	};

	egistec_fp: fingerprint_egistec {
		compatible = "egis,egistec_pd";
	};
};

&charger_policy_service {
	policy,demo-max-capacity = <35>;
	policy,demo-min-capacity = <30>;
};


&i2c4 {
	aw3644_i2c: aw3644_i2c@63 {
		compatible = "mediatek,flashlights_aw3644_i2c";
		status = "okay";
		reg = <0x63>;
	};
};

&i2c5 {
	bq2560x: bq2560x@6b {
		compatible = "ti,bq2560x_charger";
		status = "okay";
		reg = <0x6b>;

		charger_name = "primary_chg";
		alias_name = "bq2560x";
	};
};

&lk_charger {
	/delete-property/ enable_pe_plus;
	/delete-property/ enable_anime;
};

&charger {
	/delete-property/ enable_pe_plus;
	/delete-property/ enable_pe_2;
	/delete-property/ enable_pe_3;
	/delete-property/ enable_pe_4;
	/delete-property/ enable_type_c;
};

/ {
	/delete-node/ mt6370_pmu_dts;
};

/ {
	/delete-node/ type_c_port0;
};

&i2c3 {
	/delete-node/ rt9465@4b;
};

/* chosen */
&chosen {
	bootargs = "console=tty0 console=ttyS0,921600n1 \
vmalloc=300M slub_max_order=0 slub_debug=OFZPU \
page_owner=on androidboot.hardware=mt6761 \
maxcpus=8 firmware_class.path=/vendor/firmware loop.max_part=7";
};
